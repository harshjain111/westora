# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=info@westoraglobal.com
NOTIFICATION_EMAIL_FROM=

# Cloudflare Turnstile
# NEXT_PUBLIC_ prefix on the site key is required — Next.js only exposes
# prefixed vars to the browser bundle, and the widget renders client-side.
# PRD §7 lists this as TURNSTILE_SITE_KEY without the prefix; corrected
# here since the unprefixed name would never reach the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Plausible (cookieless analytics) — not in PRD §7's original env list,
# added when wiring analytics (Prompt 61). Vercel Analytics needs no env
# var; it activates automatically once deployed on Vercel.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
